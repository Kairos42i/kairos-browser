# ============================================================================
# KAIROS Browser -- Environment Configuration
# Copia este archivo a .env y ajusta los valores
! ============================================================================

# -- Chrome -----------------------------------------------------------------
CHROME_PORT=9222
CHROME_SHM_SIZE=2g

# -- MCP Server --------------------------------------------------------------
MCP_PORT=9100
MCP_CDP_HOST=chrome
MCP_CDP_PORT=9222
LOG_LEVEL=info

# -- VPN (opcional) ----------------------------------------------------------
#WG_HOST=vpn.tudominio.com
#WG_PORT=51820

# -- AI Providers -----------------------------------------------------------
# DEEPSEEK: mejor relacion costo/calidad
# DEEPSEEK_API_KEY=sk-colocar-api-key-aqui

# Opcionales:
# ANTHROPIC_API_KEY=sk-ant-colocar
# OPENAI_API_KEY=sk-colocar 
# OPENROUTER_API_KEY=sk-colocar

# -- Model Routing ---------------------------------------------------------
# Por defecto V4-Flash. Cambiar solo si es necesario.
# DEFAULT_MODEL=deepseek-v4-flash
# REASONING_MODEL=deepseek-v4-pro

# -- Storage ----------------------------------------------------------------
# DATA_DIR=./data
